<resources>
    <style name="Theme.Overkey" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/gray</item>
    </style>

    <!-- Overlay windows: 120 ms fade in, 60 ms fade out, nothing else. -->
    <style name="OverlayFade">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>
</resources>
